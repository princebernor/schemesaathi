# Copy to .env.local and fill in. Server-side only — never commit real keys.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.5-flash, falls back to gemini-flash-lite-latest)
GEMINI_MODEL=
# Optional: override the Gemini speech model (default gemini-3.1-flash-tts-preview)
GEMINI_TTS_MODEL=

# PostgreSQL. The portable server is started automatically by `npm run dev` on this port.
# Choose your own strong passwords (letters, digits, - and _).
PG_PORT=5433
PG_SUPERUSER_PASSWORD=
PG_APP_PASSWORD=
# Read-only login used to view data at http://localhost:5173/db-viewer or in any PostgreSQL client
PG_VIEWER_USER=schemesaathi_viewer
PG_VIEWER_PASSWORD=
# Optional: use an external PostgreSQL server instead of the portable one
DATABASE_URL=
