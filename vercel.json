{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://schemesaathi-api-n8ff.onrender.com/api/:path*" },
    { "source": "/db-viewer", "destination": "https://schemesaathi-api-n8ff.onrender.com/db-viewer" }
  ]
}
